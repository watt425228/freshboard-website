# Freshboard website: one address for every page, a branded page-not-found, and safe defaults.
RewriteEngine On

# www.freshboard.org -> freshboard.org
RewriteCond %{HTTP_HOST} ^www\.freshboard\.org$ [NC]
RewriteRule ^(.*)$ https://freshboard.org/$1 [R=301,L]

# /index.html -> /  (only when asked for directly, not when the server serves / itself)
RewriteCond %{THE_REQUEST} \s/+index\.html[\s?] [NC]
RewriteRule ^index\.html$ https://freshboard.org/ [R=301,L]

ErrorDocument 404 /404.html

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Strict-Transport-Security "max-age=31536000"
  # Text files for crawlers say what they are.
  <FilesMatch "\.(txt)$">
    Header set Content-Type "text/plain; charset=utf-8"
  </FilesMatch>
</IfModule>
